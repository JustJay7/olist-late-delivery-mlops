# Copy this file to .env before the first run:  cp .env.example .env
# .env is gitignored. These are local demo values; nothing outside your laptop uses them.

POSTGRES_USER=olist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist

# Service addresses inside the Docker network (containers reach each other by service name)
MLFLOW_TRACKING_URI=http://mlflow:5000
PREFECT_API_URL=http://prefect:4200/api
API_URL=http://api:8000

# Share of input columns that must drift before an alert and a retrain fire (decision 11)
DRIFT_THRESHOLD=0.25

GF_SECURITY_ADMIN_PASSWORD=change-me
